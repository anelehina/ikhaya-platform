# {{ ansible_managed }}
# Runs the read-only health check (ansible/check.yml) and logs one clear result line.
# Monitoring watches for the result line.
[Unit]
Description=ikhaya read-only health check (ansible check.yml)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ playbook_dir }}
ExecStart=/bin/sh -c 'if /usr/bin/ansible-playbook check.yml; then echo "ikhaya-check: PASS"; else rc=$?; echo "ikhaya-check: FAIL rc=$rc"; exit $rc; fi'
TimeoutStartSec=15min
