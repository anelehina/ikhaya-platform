# Limits the battery's charge level, if the hardware supports it, so an
# always-plugged-in laptop server doesn't sit at 100% (which wears the battery fastest).
# The script waits for the setting to appear: at boot it can show up a moment
# after this service starts (a boot-time race, like the Wi-Fi one in PR #12).
[Unit]
Description=Limit battery charge level

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/battery-charge-limit
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
